# Sky Forecast - environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ALL secrets are read from the environment at runtime; none are hardcoded.

# --- QWeather (和风天气) ---
# Ground-level visibility / AQI / present weather
QWEATHER_KEY=
QWEATHER_BASE_URL=https://devapi.qweather.com/v7

# --- Open-Meteo (ECMWF) ---
# Pressure-level temperature/humidity + low/mid/high cloud cover
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Runtime ---
TZ=Asia/Shanghai
LOG_LEVEL=INFO
